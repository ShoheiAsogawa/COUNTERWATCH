DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_LISTEN_ALL=1
DISCORD_CHANNEL_NAMES=counterwatch,アンチ,overwatch,ow
DISCORD_SERVER_ID=
DISCORD_OWNER_IDS=

# GitHub を正本にする（ボットは切断せず知識だけ差し替える）
GITHUB_REPO=ShoheiAsogawa/COUNTERWATCH
GITHUB_BRANCH=main
GITHUB_KNOWLEDGE_PATH=bot/knowledge.json
GITHUB_TOKEN=
GITHUB_SYNC_SECONDS=180
# 1 にすると git pull もする。vision.py などが変わったときプロセスを再起動
GIT_AUTO_PULL=0

# DeepSeek（立ち回り文章。公式APIはテキストのみで画像は読めない）
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 画像を直接読む Vision（OpenAI 互換）。DeepSeek 公式には送れない
VISION_API_KEY=
VISION_API_BASE=https://api.openai.com/v1
VISION_MODEL=gpt-4o-mini
