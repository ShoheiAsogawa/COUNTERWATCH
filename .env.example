DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_LISTEN_ALL=1
DISCORD_CHANNEL_NAMES=counterwatch,アンチ,overwatch,ow
DISCORD_SERVER_ID=
DISCORD_OWNER_IDS=

# GitHub を正本にする（ボットは切断せず知識だけ差し替える）
GITHUB_REPO=ShoheiAsogawa/COUNTERWATCH
GITHUB_BRANCH=main
GITHUB_KNOWLEDGE_PATH=bot/knowledge.json
GITHUB_TOKEN=
GITHUB_SYNC_SECONDS=180
# 1 にすると git pull もする。bot.py が変わったときだけ再起動
GIT_AUTO_PULL=0
VISION_API_KEY=
VISION_API_BASE=https://api.openai.com/v1
VISION_MODEL=gpt-4o-mini
# OPENAI_API_KEY= でも可。TABスクショの読み取り精度が上がる（未設定ならポートレート照合）
